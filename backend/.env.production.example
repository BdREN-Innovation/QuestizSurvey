# If you want Django to load this file directly, start the backend with:
# DOTENV_FILE=.env.production ENVIRONMENT=production

# Runtime mode
ENVIRONMENT=production

# Django core
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False

# Origins and host allowlist
APP_ORIGIN=https://survey.mindspear.app
API_ORIGIN=https://survey.mindspear.app
PUBLIC_APP_URL=https://survey.mindspear.app
API_BASE_URL=https://survey.mindspear.app/api
ALLOWED_HOSTS=survey.mindspear.app
CORS_ALLOWED_ORIGINS=https://survey.mindspear.app
CSRF_TRUSTED_ORIGINS=https://survey.mindspear.app

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=questizsurvey_db
DB_USER=questizsurvey_user
DB_PASSWORD=change-this-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# Reverse proxy, cookies, and browser hardening
USE_X_FORWARDED_HOST=True
TRUSTED_PROXY_IPS=127.0.0.1,::1
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
AUTH_REFRESH_COOKIE_NAME=questiz_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AI_SECRETS_ALLOW_DATABASE=False
GUNICORN_BIND=127.0.0.1:8010
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Optional: absolute private directory for response attachments.
# Defaults to backend/private_uploads. Never expose this through Nginx.
# PRIVATE_UPLOAD_ROOT=/srv/questizsurvey/app/backend/private_uploads

# Rate limits / anti-abuse thresholds
# Do not use per-second rates for configurable throttle values.
ACCOUNT_REGISTRATION_SUBNET_LIMIT=50
PUBLIC_LOGIN_RATE_LIMIT=10/min
PUBLIC_REGISTER_RATE_LIMIT=10/hour
PUBLIC_TOKEN_REFRESH_RATE_LIMIT=20/hour
ADMIN_API_RATE_LIMIT=100/hour
PUBLIC_SURVEY_START_RATE_LIMIT=300/hour
PUBLIC_SURVEY_UPDATE_RATE_LIMIT=120/hour
QUESTION_INSIGHTS_RATE_LIMIT=10/min
SURVEY_AI_SUMMARY_RATE_LIMIT=10/min
SURVEY_AI_CHAT_RATE_LIMIT=10/min
QUESTION_IMPROVE_RATE_LIMIT=10/min
PUBLIC_VERIFICATION_RESEND_WINDOW_SECONDS=900
PUBLIC_VERIFICATION_RESEND_MAX_ATTEMPTS=10
PUBLIC_PASSWORD_RESET_WINDOW_SECONDS=900
PUBLIC_PASSWORD_RESET_MAX_ATTEMPTS=10
PAYMENT_CHECKOUT_RATE_LIMIT=10/hour
PAYMENT_STATUS_RATE_LIMIT=60/hour
BKASH_CALLBACK_WINDOW_SECONDS=3600
BKASH_CALLBACK_MAX_ATTEMPTS=30

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-mail-server.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@mindspear.app

# AI provider secrets: production should use environment variables only
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Use your merchant-provided live bKash base URL here, not the sandbox URL.
BKASH_BASE_URL=
BKASH_CALLBACK_TRUSTED_IPS=
# Public HTTPS endpoint registered with bKash/AWS SNS for payment notifications.
BKASH_WEBHOOK_URL=
# AWS SNS topic ARN provided during bKash onboarding for notification signature checks.
BKASH_WEBHOOK_TOPIC_ARN=

# Single sign-on with bdren.ai accounts (ZITADEL, OpenID Connect). Off unless SSO_ENABLED=true.
# Password login keeps working either way. Switch with this file + a Gunicorn restart.
SSO_ENABLED=false
SSO_PROVIDER_LABEL=bdren.ai
SSO_ISSUER=https://auth.bdren.ai
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email urn:zitadel:iam:user:resourceowner
SSO_REDIRECT_URI=https://survey.mindspear.app/api/auth/sso/callback/
SSO_ALLOW_SIGNUP=true
# Turn on once you trust bdren.ai's email verification, to link remaining users on their next SSO sign-in.
SSO_LINK_BY_VERIFIED_EMAIL=false
SSO_CLAIM_ORGANIZATION=urn:zitadel:iam:user:resourceowner:name
# Logging out of bdren.ai also logs out of Questiz when the ZITADEL app has its Back-Channel
# Logout URI set to https://<questiz-host>/api/auth/sso/backchannel-logout/ (no setting here).
# SSO_RP_LOGOUT is the other direction: signing out of Questiz also ends the bdren.ai session.
SSO_RP_LOGOUT=false
SSO_POST_LOGOUT_REDIRECT_URI=https://survey.mindspear.app/login
SSO_RATE_LIMIT=30/min

# Plans and payments. "local" sells plans in Questiz (Stripe/bKash). "bdren" turns that off:
# bdren.ai owns packages and payments, and Questiz reads each person's limits from the bdren.ai
# allowance API (feature keys surveys, questions_per_survey, responses_per_survey on the
# "questiz" product). Defaults to "bdren" when BDREN_PRODUCT_API_KEY is set; needs SSO_ENABLED.
# Accounts with no linked bdren.ai identity get the local Free plan's limits.
BILLING_MODE=local
BDREN_API_URL=
BDREN_PRODUCT_API_KEY=
BDREN_PRODUCT_SLUG=questiz
# Webhook secret bdren.ai shows once when the product's webhook URL
# (https://<questiz-host>/api/billing/bdren/webhook/) is set. Comma-separate two during a rotation.
BDREN_WEBHOOK_SECRET=
BDREN_UPGRADE_URL=https://bdren.ai/profile/billing
BDREN_ALLOWANCE_CACHE_SECONDS=600
BDREN_ALLOWANCE_STALE_SECONDS=86400
